    {
      "name": "1. User Management Service (Auth, Users, RBAC)",
      "item": [
        {
          "name": "Register New Customer (public)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/v1/auth/register",
            "description": "Public self-registration endpoint. Always creates a 'customer' role account regardless of any role field sent.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman.customer@smartretailx.com\",\n  \"password\": \"Password123!\",\n  \"full_name\": \"Postman Customer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 or 409 (already registered)', function () {",
                  "    pm.expect([201, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
