    {
      "name": "3. Order Processing Service",
      "item": [
        {
          "name": "Create Order (Customer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/v1/orders",
            "description": "References product_id 1 - the first product created by scripts/seed_data.py. Adjust the body if your catalogue differs. Triggers order.created on RabbitMQ, which the Inventory service consumes to reserve stock.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"product_id\": 1,\n      \"quantity\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customer_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Order starts pending', function () { pm.expect(pm.response.json().status).to.eql('pending'); });",
                  "pm.environment.set('order_id', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Order as Warehouse Staff (negative test - RBAC)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/v1/orders",
            "description": "Only the 'customer' role may place orders.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"product_id\": 1,\n      \"quantity\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{staff_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Forbidden with 403', function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Order By Id (wait a couple seconds after creating, for the event round-trip)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/v1/orders/{{order_id}}",
            "description": "If run immediately after 'Create Order', status may still show 'pending' - the order.created -> inventory reservation -> order.status_changed round trip happens asynchronously over RabbitMQ, usually within ~1-2 seconds.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customer_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Order is confirmed or still pending', function () {",
                  "    pm.expect(['pending', 'confirmed', 'cancelled']).to.include(pm.response.json().status);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List My Orders (Customer)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/v1/orders?page=1&page_size=20",
            "auth": {
