# Copy this file to .env and adjust as needed. docker-compose reads .env automatically.

# Shared JWT secret used by ALL services to sign/verify tokens (HS256).
# Change this to a long random string for anything beyond local development.
JWT_SECRET_KEY=smartretailx-super-secret-dev-key-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# RabbitMQ
RABBITMQ_DEFAULT_USER=smartretailx
RABBITMQ_DEFAULT_PASS=smartretailx
RABBITMQ_URL=amqp://smartretailx:smartretailx@rabbitmq:5672/%2F

# Messaging backend selector. Leave as "rabbitmq" for local docker-compose.
# The AWS deployment (infrastructure/terraform) sets this to "sqs" on every
# ECS task instead, along with AWS_REGION and the SQS_QUEUE_URL_* variables
# below - none of these are needed locally.
MESSAGE_BROKER=rabbitmq
# AWS_REGION=eu-west-1
# SQS_QUEUE_URL_ORDER_EVENTS=
# SQS_QUEUE_URL_INVENTORY_EVENTS=
# SQS_QUEUE_URL_USER_EVENTS=
# SQS_QUEUE_URL_NOTIFICATION_QUEUE=

# Postgres credentials (one database per service)
POSTGRES_USER=smartretailx
POSTGRES_PASSWORD=smartretailx

# Grafana admin login (monitoring stack)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
